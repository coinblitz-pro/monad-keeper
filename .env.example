RPC_URL=
# Authorization is signed for this chain only (143 mainnet, 10143 testnet)
CHAIN_ID=
# Detected from OWNER_ADDRESS delegations when empty; fixed in the delegate at authorize
VALIDATOR_ID=
# Staking EOA (Ledger address) whose rewards are compounded; derived from OWNER_SECRET when empty,
# required on a server without the secret
OWNER_ADDRESS=
# Hot key that pays gas for compound txs; can do nothing else with the owner account
KEEPER_PRIVATE_KEY=
# Owner tops the keeper up to this balance after each compound (changes the delegate address)
KEEPER_BALANCE_MON=42
MIN_REWARDS_MON=1
# Each compound also delegates the owner's liquid balance above this (changes the delegate address)
OWNER_BALANCE_MON=20
BOUNDARY_PERIOD=50000
LEAD_BLOCKS=300

# Owner key for authorize/revoke without Ledger (testnet only; prompted when empty)
# Private key or mnemonic
OWNER_SECRET=
# Owner account path on Ledger or in the mnemonic; ignored for a raw private key
DERIVATION_PATH="44'/60'/0'/0/0"
